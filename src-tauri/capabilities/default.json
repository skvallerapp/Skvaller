{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window. It renders untrusted article HTML, so it gets only what its UI uses: its commands, sync and settings events, the feed and folder menus, dragging the window from the toolbars on macOS, opening web links in the system browser, and asking before unsubscribing",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-session",
    "allow-accounts",
    "allow-sign-in",
    "allow-add-local-account",
    "allow-set-active-account",
    "allow-rebuild-cache",
    "allow-sync-now",
    "allow-library",
    "allow-articles",
    "allow-article-html",
    "allow-full-text",
    "allow-set-feed-reader-view",
    "allow-set-read",
    "allow-set-starred",
    "allow-subscribe",
    "allow-unsubscribe",
    "allow-rename-feed",
    "allow-move-feed",
    "allow-create-folder",
    "allow-rename-folder",
    "allow-delete-folder",
    "allow-open-settings",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:menu:allow-new",
    "core:menu:allow-popup",
    "core:menu:allow-set-checked",
    "core:resources:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "dialog:allow-message",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
